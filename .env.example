# Configuración de garmin-hub. Copia este fichero a .env para desarrollo.
# .env solo se lee si GARMIN_HUB_ENV=dev; las variables del entorno real tienen prioridad.
# Nunca pongas valores reales en este fichero de ejemplo.

# --- Secretos obligatorios ---------------------------------------------------
# Cadena de conexión a SQL Server (SQLAlchemy + pyodbc, ODBC Driver 18).
GARMIN_HUB_DB_URL=mssql+pyodbc://USUARIO:CONTRASENA@HOST:1433/BASE?driver=ODBC+Driver+18+for+SQL+Server&Encrypt=yes&TrustServerCertificate=yes
# Secreto de 32 bytes o más. Genéralo con:
#   uv run python -c "import secrets; print(secrets.token_urlsafe(48))"
# Rotarlo cierra todas las sesiones y anula los códigos pendientes.
GARMIN_HUB_SESSION_SECRET=

# --- Secretos futuros ----------------------------------------------------------
# Obligatoria desde la feature de vinculación de cuentas Garmin.
# GARMIN_HUB_MASTER_KEYS=
# Obligatoria desde la feature de vinculación de cuentas Garmin.
# GARMIN_HUB_RAW_DIR=

# --- Configuración general ---------------------------------------------------
# Entorno: dev o prod.
GARMIN_HUB_ENV=dev
# URL pública (obligatoria). En desarrollo, http://localhost:8000.
GARMIN_HUB_PUBLIC_URL=http://localhost:8000
# Schema de SQL Server donde viven las tablas.
GARMIN_HUB_DB_SCHEMA=gh
# Proxies de confianza para X-Forwarded-For (separados por comas).
GARMIN_HUB_TRUSTED_PROXIES=127.0.0.1
# Directorio de logs y nivel de log.
GARMIN_HUB_LOG_DIR=logs
GARMIN_HUB_LOG_LEVEL=INFO

# --- Tiempos y límites (FR-002) ----------------------------------------------
# Caducidad de las invitaciones, en días.
GARMIN_HUB_INVITE_TTL_DAYS=7
# Caducidad de los códigos de restablecimiento, en horas.
GARMIN_HUB_RESET_TTL_HOURS=24
# Inactividad máxima de una sesión, en minutos.
GARMIN_HUB_SESSION_IDLE_MINUTES=30
# Duración máxima de una sesión, en horas.
GARMIN_HUB_SESSION_MAX_HOURS=12
# Bloqueo por par correo + origen: fallos y ventana en minutos.
GARMIN_HUB_LOGIN_PAIR_MAX_FAILURES=5
GARMIN_HUB_LOGIN_PAIR_WINDOW_MINUTES=15
# Bloqueo por origen: fallos y ventana en minutos.
GARMIN_HUB_LOGIN_IP_MAX_FAILURES=20
GARMIN_HUB_LOGIN_IP_WINDOW_MINUTES=15
# Límite global por correo: umbral, ventana en minutos y retardo máximo en segundos.
GARMIN_HUB_LOGIN_EMAIL_SOFT_LIMIT=50
GARMIN_HUB_LOGIN_EMAIL_SOFT_WINDOW_MINUTES=60
GARMIN_HUB_LOGIN_EMAIL_MAX_DELAY_SECONDS=10
